PROJECT_NAME=Hotel Digital Menu API
ENVIRONMENT=development
DEBUG=true

# Database: SQLite for local dev; Replace with postgresql+psycopg://user:password@host:port/dbname in production
DATABASE_URL=sqlite:///./hotel_menu.db

# Security & Authentication
JWT_SECRET_KEY=insecure_dev_jwt_secret_key_change_in_production_hotel_menu_secret_12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend & CORS
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# File Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Anti-Spam & Moderation
REVIEW_RATE_LIMIT_PER_HOUR=5
REVIEW_COOLDOWN_SECONDS=30
AUTO_APPROVE_REVIEWS=true

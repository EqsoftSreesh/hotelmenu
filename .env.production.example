# ==========================================
# HOTEL MENU SYSTEM - PRODUCTION ENVIRONMENT
# ==========================================
# Paste these variables into Dokploy's Environment Variables section

# --- DATABASE CONFIGURATION (POSTGRESQL) ---
POSTGRES_USER=hotel_user
POSTGRES_PASSWORD=Adoxhosting@123
POSTGRES_DB=hotel_menu


# --- BACKEND CONFIGURATION ---
PROJECT_NAME="Hotel Digital Menu API"
ENVIRONMENT=production
DEBUG=false

# Generate a strong 32+ character random string for production
JWT_SECRET_KEY=change_this_to_a_random_secure_32_character_secret_key_123456
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend upload limit and initial seed flag (seeds default admin and sample menu on first start)
AUTO_SEED=true
MAX_UPLOAD_SIZE_MB=10

# Production domains for CORS and QR code links (Replace with your actual VPS domains / subdomains)
FRONTEND_URL=https://menu.yourdomain.com
ALLOWED_ORIGINS=https://menu.yourdomain.com,https://admin.yourdomain.com

# --- FRONTEND (CUSTOMER MENU) BUILD ARGS ---
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
NEXT_PUBLIC_WS_URL=wss://api.yourdomain.com/api/v1/ws
NEXT_PUBLIC_BACKEND_URL=https://api.yourdomain.com

# --- ADMIN PANEL BUILD ARGS ---
NEXT_PUBLIC_CUSTOMER_MENU_URL=https://menu.yourdomain.com
